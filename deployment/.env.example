# Public DNS name only, pointing to this VPS. Host Nginx owns ports 80/443.
APP_DOMAIN=track.example.com
WEB_PORT=8080
# Run `bash manage.sh init` to generate these three secrets.
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WORKER_POLL_MS=5000
DELIVERY_PHOTO_RETENTION_DAYS=90
GEOAPIFY_API_KEY=
